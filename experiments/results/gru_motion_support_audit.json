  "scope": "All five historical development matches, their clean and two existing composite views; five-Hz input samples whose native input period is positive. Includes ungraded and unknown-label margins. No ground-truth or prediction fields used; no inference, fitting, metric scoring or changes to frozen sources.",
  "definitions": {
    "motion_support": "Existing D_valid_motion_fraction feature: finite player speed count divided by visible-position count, after central native-frame derivatives and rejection of speeds above12m/s.",
    "low_or_missing": "D_valid_motion_fraction is nonfinite or strictly less than0.25.",
    "mean_speed_missing": "D_speed_mean is nonfinite.",
    "aggregation": "Within each provider/view, average each match-view fraction equally. Stress has two views per match. No pooling across providers.",
    "normalization": "Finite values are training-median/std standardized and clipped to[-10,10]. Missing values get standardized value0 plus finite-mask0. A measured zero speed retains mask1. Rolling summaries ignore NaNs and are NaN only if the entire window is missing."
  },
  "theory": {
    "global_frame_loss_rate": "Uniform(0.02,0.08) per10s block, independent Bernoulli frame mask given that rate.",
    "probability_any_gradient_neighbor_missing": 0.0972,
    "probability_any_center_or_gradient_neighbor_missing": 0.14177,
    "conditions": "Ideal originally complete interior frames; independent frames conditional on block rate; ignores other corruption, native gaps and block edges. Agreement is not causal attribution of model errors."
  },
